# Uttopya — site estático (sem WordPress)
DirectoryIndex index.html

# /irv aponta para o site do Instituto Raphael Veiga
Redirect 302 /irv https://orangered-woodcock-265125.hostingersite.com/

# Cabeçalhos básicos
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
